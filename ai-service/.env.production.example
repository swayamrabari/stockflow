ENVIRONMENT=production
LOG_LEVEL=INFO
OPENAI_API_KEY=replace-with-openai-key
OPENAI_BASE_URL=
AI_MODEL=gpt-6-luna
AI_TEMPERATURE=0.2
AI_INTERNAL_TOKEN=generate-the-same-random-token-in-both-production-env-files
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_TOOL_CALLS=8
AI_READ_ONLY=True
AI_TOOL_MAX_ROWS=50
AI_TOOL_MAX_MOVEMENTS=100
AI_DB_STATEMENT_TIMEOUT_MS=5000
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE_SECONDS=1800
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
